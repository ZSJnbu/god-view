{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm run build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "check",
      "type": "shell",
      "command": "pnpm run check",
      "group": "test",
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    }
  ]
}
