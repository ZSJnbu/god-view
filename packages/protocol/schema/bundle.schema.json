{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "GodViewProtocolBundle",
  "description": "仅用于类型生成的聚合入口：把所有需要导出的协议类型集中引用一次，使 json-schema-to-typescript 输出单个无重复声明的模块。本文件不用于运行时校验。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": { "$ref": "events.schema.json#/$defs/GodViewEvent" },
    "agentNode": { "$ref": "events.schema.json#/$defs/AgentNodeDeclaration" },
    "agentEdge": { "$ref": "events.schema.json#/$defs/AgentEdgeDeclaration" },
    "snapshot": { "$ref": "graph.schema.json#/$defs/GraphSnapshotDocument" },
    "coverage": { "$ref": "graph.schema.json#/$defs/CoverageReport" },
    "drift": { "$ref": "graph.schema.json#/$defs/DriftFinding" },
    "story": { "$ref": "graph.schema.json#/$defs/GuidedStory" },
    "annotation": { "$ref": "graph.schema.json#/$defs/AnnotationThread" },
    "writeAccessRequest": { "$ref": "graph.schema.json#/$defs/WriteAccessRequest" },
    "changeProposal": { "$ref": "graph.schema.json#/$defs/ChangeProposal" },
    "activeChange": { "$ref": "graph.schema.json#/$defs/ActiveChange" },
    "changeDiffSummary": { "$ref": "graph.schema.json#/$defs/ChangeDiffSummary" },
    "completedChange": { "$ref": "graph.schema.json#/$defs/CompletedChange" },
    "changeReviewedPayload": { "$ref": "events.schema.json#/$defs/ChangeReviewedPayload" },
    "toolResult": { "$ref": "tools.schema.json#/$defs/ToolResult" },
    "getMapInput": { "$ref": "tools.schema.json#/$defs/GetMapInput" },
    "getMapResult": { "$ref": "tools.schema.json#/$defs/GetMapResult" },
    "beginChangeInput": { "$ref": "tools.schema.json#/$defs/BeginChangeInput" },
    "upsertNodeInput": { "$ref": "tools.schema.json#/$defs/UpsertNodeInput" },
    "upsertEdgeInput": { "$ref": "tools.schema.json#/$defs/UpsertEdgeInput" },
    "removeEntityInput": { "$ref": "tools.schema.json#/$defs/RemoveEntityInput" },
    "completeChangeInput": { "$ref": "tools.schema.json#/$defs/CompleteChangeInput" },
    "upsertStoryInput": { "$ref": "tools.schema.json#/$defs/UpsertStoryInput" },
    "answerAnnotationInput": { "$ref": "tools.schema.json#/$defs/AnswerAnnotationInput" },
    "requestWriteAccessInput": { "$ref": "tools.schema.json#/$defs/RequestWriteAccessInput" },
    "proposeChangeInput": { "$ref": "tools.schema.json#/$defs/ProposeChangeInput" },
    "startApprovedChangeInput": { "$ref": "tools.schema.json#/$defs/StartApprovedChangeInput" },
    "changeRejectedPayload": { "$ref": "events.schema.json#/$defs/ChangeRejectedPayload" },
    "adapterCapabilities": { "$ref": "tools.schema.json#/$defs/AdapterCapabilities" }
  }
}
